SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=https://your-domain.example

DB_URL=jdbc:mysql://mysql:3306/pconlineshop?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=pconlineshop

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

PAYOS_BASE_URL=https://api.payos.vn
PAYOS_LOG_LEVEL=INFO

# Either provide these as environment variables...
# DB_PASSWORD=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
#
# ...or mount Docker secrets at /run/secrets with these file names:
# /run/secrets/db.password
# /run/secrets/mail.username
# /run/secrets/mail.password
# /run/secrets/payos.client-id
# /run/secrets/payos.api-key
# /run/secrets/payos.checksum-key

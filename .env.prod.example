SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=https://your-domain.example

# Railway MySQL: set these from Railway database variables.
# Example:
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=${MYSQLUSER}
# SPRING_DATASOURCE_PASSWORD=${MYSQLPASSWORD}
SPRING_DATASOURCE_URL=jdbc:mysql://<MYSQLHOST>:<MYSQLPORT>/<MYSQLDATABASE>?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=<MYSQLUSER>
SPRING_DATASOURCE_PASSWORD=<MYSQLPASSWORD>

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

PAYOS_BASE_URL=https://api.payos.vn
PAYOS_LOG_LEVEL=INFO

# Either provide these as environment variables...
# DB_PASSWORD=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
#
# ...or mount Docker secrets at /run/secrets with these file names:
# /run/secrets/db.password
# /run/secrets/mail.username
# /run/secrets/mail.password
# /run/secrets/payos.client-id
# /run/secrets/payos.api-key
# /run/secrets/payos.checksum-key
